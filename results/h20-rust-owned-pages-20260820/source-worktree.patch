+class FakePhysicalPageRuntime:
+    def __init__(self):
+        self.pages = {}
+        self.calls = []
+
+    def init_page_pool(self, page_count):
+        self.pages = {
+            page_id: {"generation": 0, "phase": "free"}
+            for page_id in range(1, page_count + 1)
+        }
+        self.calls.append(("init", page_count))
+
+    def acquire_pages(self, page_count):
+        free = [
+            page_id
+            for page_id, state in self.pages.items()
+            if state["phase"] == "free"
+        ]
+        if page_count > len(free):
+            raise RuntimeError("physical page request exceeds pool capacity")
+        leases = []
+        for page_id in free[:page_count]:
+            state = self.pages[page_id]
+            state["generation"] += 1
+            state["phase"] = "active"
+            leases.append((page_id, state["generation"]))
+        self.calls.append(("acquire", leases))
+        return leases
+
+    def begin_page_retirement(self, leases):
+        self._transition(leases, "active", "retiring", "begin")
+
+    def abort_page_retirement(self, leases):
+        self._transition(leases, "retiring", "active", "abort")
+
+    def commit_page_retirement(self, leases):
+        self._transition(leases, "retiring", "free", "commit")
+
+    def _transition(self, leases, expected, target, operation):
+        for page_id, generation in leases:
+            state = self.pages[page_id]
+            if state != {"generation": generation, "phase": expected}:
+                raise RuntimeError("stale physical page lease")
+        for page_id, _ in leases:
+            self.pages[page_id]["phase"] = target
+        self.calls.append((operation, list(leases)))
