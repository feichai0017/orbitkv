+unsafe fn dense_ref<'a>(
+    dense: *mut OrbitKvDenseHandle,
+) -> Result<&'a OrbitKvDenseHandle, (i32, String)> {
+    if dense.is_null() {
+        return Err((
+            ORBITKV_STATUS_INVALID_ARGUMENT,
+            "Dense handle is required".to_owned(),
+        ));
+    }
+    Ok(unsafe { &*dense })
+}
+
+unsafe fn page_pool_transition(
+    dense: *mut OrbitKvDenseHandle,
+    leases: *const OrbitKvPhysicalPageLeaseV1,
+    lease_count: usize,
+    error_buffer: *mut c_char,
+    error_buffer_len: usize,
+    transition: fn(
+        &mut PhysicalPagePool,
+        &[PhysicalPageLease],
+    ) -> Result<(), orbitkv::PhysicalPagePoolError>,
+) -> i32 {
+    ffi_boundary(error_buffer, error_buffer_len, || {
+        if lease_count > 0 && leases.is_null() {
+            return Err((
+                ORBITKV_STATUS_INVALID_ARGUMENT,
+                "physical page lease buffer is required".to_owned(),
+            ));
+        }
+        let handle = unsafe { dense_ref(dense)? };
+        let inputs = if lease_count == 0 {
+            &[]
+        } else {
+            unsafe { slice::from_raw_parts(leases, lease_count) }
+        };
+        let leases = inputs
+            .iter()
+            .copied()
+            .map(PhysicalPageLease::from)
+            .collect::<Vec<_>>();
+        let mut page_pool = handle
+            .page_pool
+            .lock()
+            .map_err(|_| page_pool_mutex_error())?;
+        let pool = page_pool.as_mut().ok_or((
+            ORBITKV_STATUS_INVALID_ARGUMENT,
+            "Dense physical page pool is not initialized".to_owned(),
+        ))?;
+        transition(pool, &leases)
+            .map_err(|error| (ORBITKV_STATUS_OWNER_ERROR, error.to_string()))?;
+        Ok(ORBITKV_STATUS_OK)
+    })
+}
