+use serde::{Deserialize, Serialize};
+use thiserror::Error;
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, Ord, PartialEq, PartialOrd, Serialize)]
+pub struct PhysicalPageLease {
+    pub page_id: u32,
+    pub generation: u64,
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq, Serialize)]
+pub struct PhysicalPagePoolStats {
+    pub total_pages: u64,
+    pub free_pages: u64,
+    pub active_pages: u64,
+    pub retiring_pages: u64,
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+enum PagePhase {
+    #[default]
+    Free,
+    Active,
+    Retiring,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct PageState {
+    generation: u64,
+    phase: PagePhase,
+}
+
+#[derive(Clone, Debug)]
+pub struct PhysicalPagePool {
+    pages: Vec<PageState>,
+    free: Vec<u32>,
+    active_pages: usize,
+    retiring_pages: usize,
+}
+
+#[derive(Clone, Debug, Error, Eq, PartialEq)]
+pub enum PhysicalPagePoolError {
+    #[error("physical page pool must contain at least one page")]
+    ZeroPages,
+    #[error("physical page request exceeds pool capacity")]
+    CapacityExhausted,
+    #[error("physical page id is invalid: {0}")]
+    InvalidPageId(u32),
+    #[error("physical page lease is stale: {0:?}")]
+    StaleLease(PhysicalPageLease),
+    #[error("physical page lease is duplicated: {0:?}")]
+    DuplicateLease(PhysicalPageLease),
+    #[error("physical page generation exhausted: {0}")]
+    GenerationExhausted(u32),
+}
+
+impl PhysicalPagePool {
+    /// Creates a fixed-capacity one-based physical page pool.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error when `page_count` is zero.
+    pub fn new(page_count: u32) -> Result<Self, PhysicalPagePoolError> {
+        if page_count == 0 {
+            return Err(PhysicalPagePoolError::ZeroPages);
+        }
+        let page_count =
+            usize::try_from(page_count).map_err(|_| PhysicalPagePoolError::CapacityExhausted)?;
+        Ok(Self {
+            pages: vec![PageState::default(); page_count],
+            free: (1..=u32::try_from(page_count)
+                .map_err(|_| PhysicalPagePoolError::CapacityExhausted)?)
+                .rev()
+                .collect(),
+            active_pages: 0,
+            retiring_pages: 0,
+        })
+    }
+
+    /// Atomically acquires `count` generation-checked pages.
+    ///
+    /// # Errors
+    ///
+    /// Returns without mutation if capacity or any page generation is
+    /// exhausted.
+    pub fn acquire(&mut self, count: u32) -> Result<Vec<PhysicalPageLease>, PhysicalPagePoolError> {
+        let count = usize::try_from(count).map_err(|_| PhysicalPagePoolError::CapacityExhausted)?;
+        if count > self.free.len() {
+            return Err(PhysicalPagePoolError::CapacityExhausted);
+        }
+        for &page_id in self.free.iter().rev().take(count) {
+            let page = self.page(page_id)?;
+            if page.generation == u64::MAX {
+                return Err(PhysicalPagePoolError::GenerationExhausted(page_id));
+            }
+        }
+        let mut leases = Vec::with_capacity(count);
+        for _ in 0..count {
+            let page_id = self
+                .free
+                .pop()
+                .ok_or(PhysicalPagePoolError::CapacityExhausted)?;
+            let page = self.page_mut(page_id)?;
+            page.generation += 1;
+            page.phase = PagePhase::Active;
+            leases.push(PhysicalPageLease {
+                page_id,
+                generation: page.generation,
+            });
+        }
+        self.active_pages += count;
+        Ok(leases)
+    }
+
+    /// Atomically moves active pages into the retiring phase.
+    ///
+    /// # Errors
+    ///
+    /// Returns without mutation for duplicate, stale, or non-active leases.
+    pub fn begin_retirement(
+        &mut self,
+        leases: &[PhysicalPageLease],
+    ) -> Result<(), PhysicalPagePoolError> {
+        self.validate_batch(leases, PagePhase::Active)?;
+        for &lease in leases {
+            self.page_mut(lease.page_id)?.phase = PagePhase::Retiring;
+        }
+        self.active_pages -= leases.len();
+        self.retiring_pages += leases.len();
+        Ok(())
+    }
+
+    /// Restores a retiring batch to active ownership.
+    ///
+    /// # Errors
+    ///
+    /// Returns without mutation for duplicate or stale leases.
+    pub fn abort_retirement(
+        &mut self,
+        leases: &[PhysicalPageLease],
+    ) -> Result<(), PhysicalPagePoolError> {
+        self.validate_batch(leases, PagePhase::Retiring)?;
+        for &lease in leases {
+            self.page_mut(lease.page_id)?.phase = PagePhase::Active;
+        }
+        self.retiring_pages -= leases.len();
+        self.active_pages += leases.len();
+        Ok(())
+    }
+
+    /// Atomically returns a retiring batch to the free pool.
+    ///
+    /// # Errors
+    ///
+    /// Returns without mutation for duplicate or stale leases.
+    pub fn commit_retirement(
+        &mut self,
+        leases: &[PhysicalPageLease],
+    ) -> Result<(), PhysicalPagePoolError> {
+        self.validate_batch(leases, PagePhase::Retiring)?;
+        for &lease in leases {
+            self.page_mut(lease.page_id)?.phase = PagePhase::Free;
+        }
+        let mut page_ids = leases.iter().map(|lease| lease.page_id).collect::<Vec<_>>();
+        page_ids.sort_unstable_by(|left, right| right.cmp(left));
+        self.free.extend(page_ids);
+        self.free.sort_unstable_by(|left, right| right.cmp(left));
+        self.retiring_pages -= leases.len();
+        Ok(())
+    }
+
+    #[must_use]
+    pub fn stats(&self) -> PhysicalPagePoolStats {
+        PhysicalPagePoolStats {
+            total_pages: self.pages.len() as u64,
+            free_pages: self.free.len() as u64,
+            active_pages: self.active_pages as u64,
+            retiring_pages: self.retiring_pages as u64,
+        }
+    }
+
+    fn validate_batch(
+        &self,
+        leases: &[PhysicalPageLease],
+        expected_phase: PagePhase,
+    ) -> Result<(), PhysicalPagePoolError> {
+        let mut sorted = leases.to_vec();
+        sorted.sort();
+        if let Some(duplicate) = sorted
+            .windows(2)
+            .find(|pair| pair[0].page_id == pair[1].page_id)
+            .map(|pair| pair[0])
+        {
+            return Err(PhysicalPagePoolError::DuplicateLease(duplicate));
+        }
+        for &lease in leases {
+            let page = self.page(lease.page_id)?;
+            if page.generation != lease.generation || page.phase != expected_phase {
+                return Err(PhysicalPagePoolError::StaleLease(lease));
+            }
+        }
+        Ok(())
+    }
+
+    fn page(&self, page_id: u32) -> Result<&PageState, PhysicalPagePoolError> {
+        let index = page_id
+            .checked_sub(1)
+            .and_then(|index| usize::try_from(index).ok())
+            .ok_or(PhysicalPagePoolError::InvalidPageId(page_id))?;
+        self.pages
+            .get(index)
+            .ok_or(PhysicalPagePoolError::InvalidPageId(page_id))
+    }
+
+    fn page_mut(&mut self, page_id: u32) -> Result<&mut PageState, PhysicalPagePoolError> {
+        let index = page_id
+            .checked_sub(1)
+            .and_then(|index| usize::try_from(index).ok())
+            .ok_or(PhysicalPagePoolError::InvalidPageId(page_id))?;
+        self.pages
+            .get_mut(index)
+            .ok_or(PhysicalPagePoolError::InvalidPageId(page_id))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn retirement_requires_exact_generation_and_two_phase_commit() {
+        let mut pool = PhysicalPagePool::new(2).unwrap();
+        let first = pool.acquire(1).unwrap();
+        pool.begin_retirement(&first).unwrap();
+        assert_eq!(
+            pool.stats(),
+            PhysicalPagePoolStats {
+                total_pages: 2,
+                free_pages: 1,
+                active_pages: 0,
+                retiring_pages: 1,
+            }
+        );
+        assert_eq!(
+            pool.acquire(2),
+            Err(PhysicalPagePoolError::CapacityExhausted)
+        );
+        pool.commit_retirement(&first).unwrap();
+        let second = pool.acquire(2).unwrap();
+        let reused = second
+            .iter()
+            .find(|lease| lease.page_id == first[0].page_id)
+            .unwrap();
+        assert_eq!(reused.generation, first[0].generation + 1);
+        assert_eq!(
+            pool.begin_retirement(&first),
+            Err(PhysicalPagePoolError::StaleLease(first[0]))
+        );
+    }
+
+    #[test]
+    fn batch_transition_is_atomic_on_duplicate_or_stale_lease() {
+        let mut pool = PhysicalPagePool::new(2).unwrap();
+        let leases = pool.acquire(2).unwrap();
+        let duplicate = [leases[0], leases[0]];
+        assert_eq!(
+            pool.begin_retirement(&duplicate),
+            Err(PhysicalPagePoolError::DuplicateLease(leases[0]))
+        );
+        assert_eq!(pool.stats().active_pages, 2);
+        let stale = [
+            leases[0],
+            PhysicalPageLease {
+                generation: leases[1].generation + 1,
+                ..leases[1]
+            },
+        ];
+        assert_eq!(
+            pool.begin_retirement(&stale),
+            Err(PhysicalPagePoolError::StaleLease(stale[1]))
+        );
+        assert_eq!(pool.stats().active_pages, 2);
+    }
+
+    #[test]
+    fn committed_pages_are_reacquired_in_ascending_page_order() {
+        let mut pool = PhysicalPagePool::new(4).unwrap();
+        let leases = pool.acquire(4).unwrap();
+        pool.begin_retirement(&[leases[3], leases[1]]).unwrap();
+        pool.commit_retirement(&[leases[3], leases[1]]).unwrap();
+
+        let reacquired = pool.acquire(2).unwrap();
+        assert_eq!(
+            reacquired
+                .iter()
+                .map(|lease| lease.page_id)
+                .collect::<Vec<_>>(),
+            vec![2, 4]
+        );
+    }
+}

