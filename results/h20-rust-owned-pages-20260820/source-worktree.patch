+/// Initializes the Rust-owned physical page pool.
+///
+/// # Safety
+///
+/// `dense` must be live. Reinitialization is rejected.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn orbitkv_dense_page_pool_init(
+    dense: *mut OrbitKvDenseHandle,
+    page_count: u32,
+    error_buffer: *mut c_char,
+    error_buffer_len: usize,
+) -> i32 {
+    ffi_boundary(error_buffer, error_buffer_len, || {
+        let handle = unsafe { dense_ref(dense)? };
+        let mut page_pool = handle
+            .page_pool
+            .lock()
+            .map_err(|_| page_pool_mutex_error())?;
+        if page_pool.is_some() {
+            return Err((
+                ORBITKV_STATUS_INVALID_ARGUMENT,
+                "Dense physical page pool is already initialized".to_owned(),
+            ));
+        }
+        *page_pool = Some(
+            PhysicalPagePool::new(page_count)
+                .map_err(|error| (ORBITKV_STATUS_OWNER_ERROR, error.to_string()))?,
+        );
+        Ok(ORBITKV_STATUS_OK)
+    })
+}
+
+/// Acquires physical pages selected by `OrbitKV`.
+///
+/// # Safety
+///
+/// `leases` must reference `lease_capacity` writable entries.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn orbitkv_dense_page_pool_acquire(
+    dense: *mut OrbitKvDenseHandle,
+    page_count: u32,
+    leases: *mut OrbitKvPhysicalPageLeaseV1,
+    lease_capacity: usize,
+    error_buffer: *mut c_char,
+    error_buffer_len: usize,
+) -> i32 {
+    ffi_boundary(error_buffer, error_buffer_len, || {
+        if usize::try_from(page_count)
+            .ok()
+            .is_none_or(|count| count > lease_capacity)
+            || (page_count > 0 && leases.is_null())
+        {
+            return Err((
+                ORBITKV_STATUS_INVALID_ARGUMENT,
+                "physical page lease buffer is too small".to_owned(),
+            ));
+        }
+        let handle = unsafe { dense_ref(dense)? };
+        let mut page_pool = handle
+            .page_pool
+            .lock()
+            .map_err(|_| page_pool_mutex_error())?;
+        let pool = page_pool.as_mut().ok_or((
+            ORBITKV_STATUS_INVALID_ARGUMENT,
+            "Dense physical page pool is not initialized".to_owned(),
+        ))?;
+        let acquired = pool
+            .acquire(page_count)
+            .map_err(|error| (ORBITKV_STATUS_OWNER_ERROR, error.to_string()))?;
+        for (index, lease) in acquired.into_iter().enumerate() {
+            unsafe {
+                leases.add(index).write(lease.into());
+            }
+        }
+        Ok(ORBITKV_STATUS_OK)
+    })
+}
