(rule (
                (= ?producer_fe
                   (Op (FusionEnd ?shape ?stride ?dt) (ICons ?producer_inner (INil))))
                (= ?boundary
                   (Op (FusionStart ?shape ?stride ?dt) (ICons ?producer_fe (INil))))
             ) (
                (union ?boundary ?producer_inner)
                (subsume
                    (Op (FusionStart ?shape ?stride ?dt) (ICons ?producer_fe (INil))))
             ) :ruleset fusion_inline_safe_late
                :name "inline-safe-FE-through-FS")