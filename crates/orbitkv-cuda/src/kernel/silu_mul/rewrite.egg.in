; The physical spans and every view stride must agree before replacing casts
; and primitive kernels with contiguous vector loads. Column tails are not
; admitted. Runtime pointer alignment is checked inside the kernel because an
; externally bound buffer need not inherit the arena's allocation alignment.
(rule
    ((= ?shape (ECons ?rows (ECons ?width_expr (ENil))))
     (= ?width_expr (MNum ?width)) (> ?width 0)
     (= (% ?width {vector_elements}) 0)
     (= ?stride (ECons (MMul (MIter) ?width_expr) (ECons (MIter) (ENil))))
     (= ?broadcast (ECons (MNum 0) (ECons (MNum 0) (ENil))))
     {size_proof}
     (= ?gate_f32 (Op (Cast ?span (F32)) (ICons ?gate (INil))))
     (= ?up_f32 (Op (Cast ?span (F32)) (ICons ?up (INil))))
     (= (dtype ?gate) (Bf16)) (= (dtype ?up) (Bf16))

     (= ?negative (Op (Mul ?shape ?stride ?broadcast ?stride)
        (ICons ?gate_f32 (ICons ?minus_one (INil)))))
     (= ?minus_one (Op (Constant -1.000000) (INil)))
     (= ?scaled (Op (Mul ?shape ?stride ?broadcast ?stride)
        (ICons ?negative (ICons ?log2e (INil)))))
     (= ?log2e (Op (Constant 1.442695) (INil)))
     (= ?exponential (Op (Exp2 ?shape ?stride ?stride) (ICons ?scaled (INil))))
     (= ?denominator (Op (Add ?shape ?stride ?broadcast ?stride)
        (ICons ?exponential (ICons ?one (INil)))))
     (= ?one (Op (Constant 1.000000) (INil)))
     (= ?sigmoid (Op (Recip ?shape ?stride ?stride) (ICons ?denominator (INil))))
     (= ?activated (Op (Mul ?shape ?stride ?stride ?stride)
        (ICons ?gate_f32 (ICons ?sigmoid (INil)))))
     (= ?rounded (Op (Cast ?span (Bf16)) (ICons ?activated (INil))))
     (= ?widened (Op (Cast ?span (F32)) (ICons ?rounded (INil))))
     (= ?product (Op (Mul ?shape ?stride ?stride ?stride)
        (ICons ?widened (ICons ?up_f32 (INil)))))
     (= ?out (Op (Cast ?span (Bf16)) (ICons ?product (INil)))))
    ((let ?candidate (Op (KernelSiluMul (MMul ?rows ?width_expr)) (ICons ?gate (ICons ?up (INil)))))
     (union ?out ?candidate) (set (dtype ?candidate) (Bf16))
     (set (default-priority (KernelSiluMul (MMul ?rows ?width_expr))) 40))
    :ruleset kernel_fuse_late
    :name "sglang vector silu mul preserving f32 chain {variant}")
