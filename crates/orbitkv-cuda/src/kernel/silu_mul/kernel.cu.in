// SPDX-License-Identifier: Apache-2.0
// Adapted from SGLang activation.cuh and vec.cuh at
// 095ec6c997bfdd25d3864cb0ce77a6562a934b96. See NOTICE and LICENSE.
// Changes: separate gate/up, F32 graph arithmetic instead of expf SiLU,
// 64-bit vector indexing, runtime alignment fallback, and OrbitKV launch ABI.
#include <cuda_bf16.h>
{dyn_defines}

namespace {{
constexpr int kVecSize = {vector_elements};
struct alignas(16) Vector {{
    __nv_bfloat16 data[kVecSize];
    __device__ __nv_bfloat16& operator[](int index) {{ return data[index]; }}
    __device__ __nv_bfloat16 operator[](int index) const {{ return data[index]; }}
}};

// Preserve every F32 primitive and the activation's BF16 boundary. SGLang's
// apply_activation_f32 uses expf; that is not this graph's arithmetic contract.
__device__ __forceinline__ float activate(float gate) {{
    const float negative = __fmul_rn(gate, -1.0f);
    const float scaled = __fmul_rn(negative, 1.442695f);
    const float exponential = exp2f(scaled);
    const float denominator = __fadd_rn(exponential, 1.0f);
    const float sigmoid = 1.0f / denominator;
    return __fmul_rn(gate, sigmoid);
}}
}} // namespace

extern "C" __global__ void silu_mul(
    __nv_bfloat16* __restrict__ output,
    const __nv_bfloat16* __restrict__ gate_input,
    const __nv_bfloat16* __restrict__ up_input{dyn_parameter}
) {{
    // SGLang's act_and_mul_kernel work division, with independent input
    // buffers. A vector always stays within a row by the rewrite's width proof.
    const long long tid = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
    if (tid >= {num_vectors}) return;
    // CUDA device pointers use the 64-bit ABI; avoid host libc headers in NVRTC.
    const bool aligned = ((reinterpret_cast<unsigned long long>(gate_input)
        | reinterpret_cast<unsigned long long>(up_input)
        | reinterpret_cast<unsigned long long>(output)) & (alignof(Vector) - 1)) == 0;
    Vector gate, up;
    if (aligned) {{
        gate = reinterpret_cast<const Vector*>(gate_input)[tid];
        up = reinterpret_cast<const Vector*>(up_input)[tid];
    }} else {{
#pragma unroll
        for (int i = 0; i < kVecSize; ++i) {{
            gate[i] = gate_input[tid * kVecSize + i];
            up[i] = up_input[tid * kVecSize + i];
        }}
    }}
    Vector out;
#pragma unroll
    for (int i = 0; i < kVecSize; ++i) {{
        const float gate_f32 = __bfloat162float(gate[i]);
        const float up_f32 = __bfloat162float(up[i]);
        // SGLang kRoundActivation branch, retaining its intermediate cast.
        const __nv_bfloat16 activated = __float2bfloat16_rn(activate(gate_f32));
        out[i] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(activated), up_f32));
    }}
    if (aligned) {{
        reinterpret_cast<Vector*>(output)[tid] = out;
    }} else {{
#pragma unroll
        for (int i = 0; i < kVecSize; ++i) {{
            output[tid * kVecSize + i] = out[i];
        }}
    }}
}}
