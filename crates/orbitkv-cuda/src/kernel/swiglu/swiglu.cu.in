{includes}
extern "C" __global__ void swiglu_k(
    {ty}* __restrict__ out,
    const {ty}* __restrict__ x
) {{
    const long long I = {i};
    long long row = blockIdx.x;
    long long col = (long long)blockIdx.y * {TPB} + threadIdx.x;
    if (col >= I) return;
    const {ty}* xr = x + row * (2 * I);
    float g = (float)xr[col];
    float u = (float)xr[I + col];
    {body}
}}
