; Exact [rows, 2*i] storage and [rows, i] intermediates. In particular, a
; [rows, 3*i] producer sliced to gate/up must not lose its physical row pitch.
(= ?o_sh (ECons ?rows (ECons ?i (ENil))))
(= ?i (MNum ?width))
(> ?width 0)
(= ?pitch (MNum ?pitch_value))
(= ?pitch_value (* ?width 2))
(= ?input_shape (ECons ?rows (ECons ?pitch (ENil))))
(= ?input_stride (ECons (MMul (MIter) ?pitch) (ECons (MIter) (ENil))))
(= ?stride (ECons (MMul (MIter) ?i) (ECons (MIter) (ENil))))
(= ?broadcast (ECons (MNum 0) (ECons (MNum 0) (ENil))))

(= ?ng (Op (Mul ?o_sh ?input_stride ?broadcast ?stride)
    (ICons ?x (ICons ?negb (INil)))))
(= ?negb (Op (Cast (MNum 1) (Bf16)) (ICons ?negc (INil))))
(= ?negc (Op (Constant -1.000000) (INil)))
(= ?sc (Op (Mul ?o_sh ?stride ?broadcast ?stride)
    (ICons ?ng (ICons ?l2eb (INil)))))
(= ?l2eb (Op (Cast (MNum 1) (Bf16)) (ICons ?l2ec (INil))))
(= ?l2ec (Op (Constant 1.442695) (INil)))
(= ?ex (Op (Exp2 ?o_sh ?stride ?stride) (ICons ?sc (INil))))
(= ?pl1 (Op (Add ?o_sh ?stride ?broadcast ?stride)
    (ICons ?ex (ICons ?oneb (INil)))))
(= ?oneb (Op (Cast (MNum 1) (Bf16)) (ICons ?onec (INil))))
(= ?onec (Op (Constant 1.000000) (INil)))
(= ?sig (Op (Recip ?o_sh ?stride ?stride) (ICons ?pl1 (INil))))
(= ?silu (Op (Mul ?o_sh ?input_stride ?stride ?stride)
    (ICons ?x (ICons ?sig (INil)))))

(= ?out (Op (Mul ?o_sh ?stride ?stride ?stride)
    (ICons ?silu (ICons ?up (INil)))))
(= ?up (Op (Gather ?o_sh ?stride ?input_shape ?input_stride)
    (ICons ?upidx (ICons ?x (INil)))))
(= ?upidx (Op (Iota
    (MAdd (MAdd (MMod (MIter) ?i) ?i)
          (MMul (MDiv (MIter) ?i) ?pitch))
    ?up_range) (INil)))
(= (Bf16) (dtype ?x))
