; Exact selected-state geometry; every source and index view stride survives.
; This candidate is read-only. Scatter/state_commit retains publication and
; alias authority, including candidate-local checks for observing old state.
(rule
    ((packed-delta-scan-geometry ?cid ?tokens ?requests ?kh ?vh ?kw ?vw ?epsilon ?round_qk ?round_state)
     (> ?kw 0) (<= ?kw 128) (> ?vw 0)
     (= ?shape (ECons ?requests
        (ECons (MNum ?vh) (ECons (MNum ?kw) (ECons (MNum ?vw) (ENil))))))
     (= ?selected (Op (Gather ?shape ?index_stride ?data_shape ?data_stride)
        (ICons ?indices (ICons ?arena (INil)))))
     (= (dtype ?indices) (Int)) (= (dtype ?arena) (F32))
     (= ?original (Op (CustomOpKind ?cid (F32))
        (ICons ?query (ICons ?key (ICons ?value (ICons ?decay
        (ICons ?gate (ICons ?selected (ICons ?indptr (INil)))))))))))
    ((let ?candidate (Op
        (KernelDeltaGather ?tokens ?requests ?kh ?vh ?kw ?vw ?epsilon ?round_qk ?round_state
            ?shape ?index_stride ?data_shape ?data_stride)
        (ICons ?query (ICons ?key (ICons ?value (ICons ?decay
        (ICons ?gate (ICons ?arena (ICons ?indices (ICons ?indptr (INil)))))))))))
     (union ?original ?candidate) (set (dtype ?candidate) (F32))
     (set (default-priority
        (KernelDeltaGather ?tokens ?requests ?kh ?vh ?kw ?vw ?epsilon ?round_qk ?round_state
            ?shape ?index_stride ?data_shape ?data_stride)) 30))
    :ruleset kernel_specialize
    :name "load delta initial state through its gather indices")
