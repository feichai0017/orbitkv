(rule
    ((packed-delta-scan-geometry ?cid ?tokens ?requests ?kh ?vh ?kw ?vw ?epsilon ?round_qk ?round_state)
     (> ?kw 0) (<= ?kw 128) (> ?vw 0)
     (= ?original (Op (CustomOpKind ?cid (F32)) ?inputs)))
    ((let ?candidate (Op (KernelDeltaRegisters ?tokens ?requests ?kh ?vh ?kw ?vw ?epsilon ?round_qk ?round_state) ?inputs))
     (union ?original ?candidate)
     (set (dtype ?candidate) (F32))
     (set (default-priority
        (KernelDeltaRegisters ?tokens ?requests ?kh ?vh ?kw ?vw ?epsilon ?round_qk ?round_state)) 20))
    :ruleset kernel_specialize
    :name "register-resident delta scan with bounded key width")
