; Candidate-local alias validation must still reject unordered readers.
(rule
    (
        (packed-convolution-op ?op_id)
        (= ?commit (Op
            (KernelScatter ?arena_shape ?arena_stride ?index_shape
                ?index_stride ?source_stride ?arena_out_stride (Bf16))
            (ICons ?arena (ICons ?indices (ICons ?next_history (INil))))))
        (= ?next_history (Op
            (Gather ?history_shape ?history_stride ?packed_shape ?packed_stride)
            (ICons ?history_indices (ICons ?packed (INil)))))
        (= ?packed (Op (CustomOpKind ?op_id (Bf16))
            (ICons ?input
            (ICons ?weights
            (ICons ?selected
            (ICons ?indptr (INil)))))))
        (= ?selected (Op
            (Gather ?selected_shape ?selected_stride ?arena_shape ?arena_stride)
            (ICons ?selected_indices (ICons ?selected_arena (INil)))))
        (= ?indices ?selected_indices)
        (= ?arena ?selected_arena)
        (= ?arena_stride ?arena_out_stride)
    )
    (
        (let ?in_place (Op
            (KernelScatterNoCopy ?arena_shape ?arena_stride ?index_shape
                ?index_stride ?source_stride ?arena_out_stride (Bf16))
            (ICons ?arena (ICons ?indices (ICons ?next_history (INil))))))
        (union ?commit ?in_place)
        (set (dtype ?in_place) (Bf16))
        (set (default-priority
            (KernelScatterNoCopy ?arena_shape ?arena_stride ?index_shape
                ?index_stride ?source_stride ?arena_out_stride (Bf16))) 10)
    )
    :ruleset kernel_specialize
    :name "commit packed convolution state to selected arena slots"
)

(rule
    (
        (packed-delta-scan-op ?op_id)
        (= ?commit (Op
            (KernelScatter ?arena_shape ?arena_stride ?index_shape
                ?index_stride ?source_stride ?arena_out_stride (F32))
            (ICons ?arena (ICons ?indices (ICons ?next_state (INil))))))
        (= ?next_state (Op
            (Gather ?state_shape ?state_stride ?packed_shape ?packed_stride)
            (ICons ?state_indices (ICons ?packed (INil)))))
        (= ?packed (Op (CustomOpKind ?op_id (F32))
            (ICons ?query
            (ICons ?key
            (ICons ?value
            (ICons ?decay
            (ICons ?gate
            (ICons ?selected
            (ICons ?indptr (INil))))))))))
        (= ?selected (Op
            (Gather ?selected_shape ?selected_stride ?arena_shape ?arena_stride)
            (ICons ?selected_indices (ICons ?selected_arena (INil)))))
        (= ?indices ?selected_indices)
        (= ?arena ?selected_arena)
        (= ?arena_stride ?arena_out_stride)
    )
    (
        (let ?in_place (Op
            (KernelScatterNoCopy ?arena_shape ?arena_stride ?index_shape
                ?index_stride ?source_stride ?arena_out_stride (F32))
            (ICons ?arena (ICons ?indices (ICons ?next_state (INil))))))
        (union ?commit ?in_place)
        (set (dtype ?in_place) (F32))
        (set (default-priority
            (KernelScatterNoCopy ?arena_shape ?arena_stride ?index_shape
                ?index_stride ?source_stride ?arena_out_stride (F32))) 10)
    )
    :ruleset kernel_specialize
    :name "commit packed recurrent state to selected arena slots"
)
