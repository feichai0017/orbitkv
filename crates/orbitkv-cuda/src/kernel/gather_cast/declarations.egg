; Only byte-addressed float conversions with qualified CUDA rounding semantics.
(relation gather-cast-types (DType DType))
(gather-cast-types (Bf16) (F32))
(gather-cast-types (F16) (F32))
(gather-cast-types (F32) (Bf16))
(gather-cast-types (F32) (F16))

; Anchor the output-size calculation to actual gather shapes. This avoids
; unconstrained expression products in the model e-graph.
(relation gather-cast-shape (EList))
(function gather-cast-elements (EList) Expression :merge old)
