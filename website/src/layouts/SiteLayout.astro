---
import { navigation, repositoryUrl } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = "Loom Infer | Rust-native inference operators",
  description = "A Rust-native, FlashInfer-class CUDA operator layer built with cuda-oxide.",
  active = "",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const local = (href: string) => `${base}${href}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b0a" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Loom Infer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={local("/")} aria-label="Loom Infer home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="brand-name">Loom Infer</span>
          <span class="brand-version">alpha</span>
        </a>

        <nav aria-label="Primary navigation">
          {navigation.map((item) => (
            <a
              href={local(item.href)}
              aria-current={active === item.label ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <a class="source-link" href={repositoryUrl} target="_blank" rel="noreferrer" aria-label="Loom Infer source on GitHub">
          <span>Source</span><span aria-hidden="true">↗</span>
        </a>
      </header>

      <main id="content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-brand">
          <span class="footer-glyph" aria-hidden="true">LI</span>
          <div><strong>Loom Infer</strong><p>Rust-native inference operators.</p></div>
        </div>
        <div class="footer-links">
          <a href={local("/docs/")}>Docs</a>
          <a href={local("/docs/operators/")}>Operators</a>
          <a href={local("/evidence/")}>Evidence</a>
          <a href={`${repositoryUrl}/blob/main/LICENSE`}>MIT</a>
        </div>
        <p class="footer-note">H20 evidence · shape-specific claims</p>
      </footer>
    </div>
  </body>
</html>
