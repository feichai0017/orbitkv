---
import { localUrl, navigation, repositoryUrl, sourceUrl } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = "OrbitKV — Compile the lifetime of state",
  description = "A framework-neutral state cache and physical planner for vLLM and SGLang.",
  active = "",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f0" />
    <link rel="icon" type="image/svg+xml" href={localUrl("/favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OrbitKV" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="brand" href={localUrl("/")} aria-label="OrbitKV home">
        <img src={localUrl("/favicon.svg")} width="32" height="32" alt="" />
        <span>ORBITKV</span>
      </a>
      <nav aria-label="Primary navigation">
        {navigation.map((item) => (
          <a
            href={localUrl(item.href)}
            aria-current={active === item.label ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        class="source-link"
        href={repositoryUrl}
        aria-label="OrbitKV source on GitHub"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>
        ORBITKV <span>Rust. CUDA. vLLM. SGLang.</span>
      </p>
      <div class="footer-links">
        <a href={sourceUrl("docs/roadmap.md")}>
          Roadmap <span aria-hidden="true">↗</span>
        </a>
        <a href={repositoryUrl}>
          Source <span aria-hidden="true">↗</span>
        </a>
        <a href={sourceUrl("LICENSE")}>
          Apache-2.0 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
  </body>
</html>
