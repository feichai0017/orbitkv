---
import type { MarkdownHeading } from "astro";
import DocSearch from "../components/DocSearch.astro";
import { docGroups, docPages } from "../data/docs";
import { localUrl, sourceUrl } from "../data/site";
import SiteLayout from "./SiteLayout.astro";
import "../styles/docs.css";

interface Props {
  title: string;
  slug?: string;
  headings?: MarkdownHeading[];
}
const { title, slug, headings = [] } = Astro.props;
const index = docPages.findIndex((page) => page.slug === slug);
const adjacent = [
  index > 0 ? docPages[index - 1] : undefined,
  index >= 0 ? docPages[index + 1] : undefined,
];
---

<SiteLayout
  title={`${title} — OrbitKV`}
  description={`${title}. OrbitKV documentation for cache deployment, operation and design.`}
  active="Docs"
>
  <div class="container docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <DocSearch />
      <details class="docs-navigation" open>
        <summary>Browse documentation</summary>
        <nav aria-label="Documentation sections">
          <a class="docs-home" href={localUrl("/docs/")}>
            Documentation home
          </a>
          {docGroups.map((group) => (
            <section>
              <h2>{group.title}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a
                      href={localUrl(`/docs/${item.slug}/`)}
                      aria-current={slug === item.slug ? "page" : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </details>
    </aside>
    <div class="doc-main">
      <div class="doc-meta">
        <a href={localUrl("/docs/")}>Documentation</a>
        <span>{docPages[index]?.group ?? "Start here"}</span>
      </div>
      <article class="doc-content">
        <slot />
      </article>
      {slug && (
        <footer class="doc-footer">
          <a href={sourceUrl(`docs/${slug}.md`)}>View this page on GitHub ↗</a>
          <nav aria-label="Adjacent documentation">
            {adjacent.map((page, i) =>
              page ? (
                <a href={localUrl(`/docs/${page.slug}/`)}>
                  <span>{i === 0 ? "← Previous" : "Next →"}</span>
                  {page.title}
                </a>
              ) : (
                <span />
              ),
            )}
          </nav>
        </footer>
      )}
    </div>
    {headings.some((heading) => heading.depth === 2) && (
      <aside class="docs-toc" aria-label="On this page">
        <p>On this page</p>
        <ul>
          {headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
        </ul>
      </aside>
    )}
  </div>
</SiteLayout>

<script>
  const navigation =
    document.querySelector<HTMLDetailsElement>(".docs-navigation")!;
  const compact = window.matchMedia("(max-width: 55rem)");
  const resize = () => {
    navigation.open = !compact.matches;
  };
  resize();
  compact.addEventListener("change", resize);
  if (document.querySelector(".mermaid")) {
    const { default: mermaid } = await import("mermaid");
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      flowchart: { useMaxWidth: false },
      sequence: { useMaxWidth: false },
      state: { useMaxWidth: false },
      themeVariables: {
        fontFamily: "Arial, Helvetica, sans-serif",
        primaryColor: "#fcfbf8",
        primaryTextColor: "#202d26",
        primaryBorderColor: "#203b30",
        lineColor: "#60695f",
        secondaryColor: "#f6f5f0",
        tertiaryColor: "#f6f5f0",
      },
    });
    await mermaid.run({ querySelector: ".mermaid" });
  }
</script>
