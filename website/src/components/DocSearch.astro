---
import { localUrl } from "../data/site";
---

<div class="doc-search" data-index-url={localUrl("/docs/search.json")}>
  <label for="docs-search">Search documentation</label>
  <input
    id="docs-search"
    type="search"
    placeholder="e.g. SSD, vLLM, etcd"
    autocomplete="off"
  />
  <p class="search-status" role="status"></p>
  <ul class="search-results" hidden></ul>
</div>

<script>
  const search = document.querySelector<HTMLElement>(".doc-search")!;
  const input = search.querySelector("input")!;
  const results = search.querySelector<HTMLUListElement>(".search-results")!;
  const status = search.querySelector(".search-status")!;
  type Page = { title: string; url: string; body: string };
  let index: Promise<Page[]> | undefined;
  let revision = 0;
  input.addEventListener("input", async () => {
    const current = ++revision;
    const query = input.value.trim().toLowerCase();
    results.replaceChildren();
    results.hidden = true;
    status.textContent = "";
    if (query.length < 2) return;
    try {
      index ??= fetch(search.dataset.indexUrl!).then((response) => {
        if (!response.ok) throw new Error("Search index unavailable");
        return response.json();
      });
      const pages = await index;
      if (current !== revision) return;
      const terms = query.split(/\s+/);
      const matches = pages
        .filter((page) =>
          terms.every((term) =>
            `${page.title} ${page.body}`.toLowerCase().includes(term),
          ),
        )
        .sort(
          (a, b) =>
            Number(b.title.toLowerCase().includes(query)) -
            Number(a.title.toLowerCase().includes(query)),
        );
      status.textContent = matches.length
        ? `${matches.length} pages found`
        : "No matching pages.";
      for (const page of matches.slice(0, 10)) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = page.url;
        link.textContent = page.title;
        item.append(link);
        results.append(item);
      }
      results.hidden = !matches.length;
    } catch {
      index = undefined;
      if (current !== revision) return;
      status.textContent = "Search unavailable. Browse the sections below.";
    }
  });
</script>
