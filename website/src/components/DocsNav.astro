---
import { localUrl, sourceUrl } from "../data/site";
interface Props {
  active: "Architecture" | "Evidence";
}
const { active } = Astro.props;
const items = [
  { label: "Architecture", href: "/docs/" },
  { label: "Evidence", href: "/evidence/" },
];
---

<aside class="docs-sidebar" aria-label="Documentation navigation">
  <p>Inside OrbitKV</p>
  {items.map((item) => (
    <a
      href={localUrl(item.href)}
      aria-current={active === item.label ? "page" : undefined}
    >
      {item.label}
    </a>
  ))}
  <a class="sidebar-source" href={sourceUrl("docs/roadmap.md")}>
    Roadmap ↗
  </a>
  <a href={sourceUrl("README.md#quickstart")}>Getting started ↗</a>
</aside>
