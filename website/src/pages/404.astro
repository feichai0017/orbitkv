---
import SiteLayout from "../layouts/SiteLayout.astro";
import { localUrl } from "../data/site";
---

<SiteLayout title="Page not found — OrbitKV">
  <header class="page-hero">
    <p class="eyebrow">404</p>
    <h1>A little outside the orbit.</h1>
    <p>
      This page may have moved. The overview is a good place to start again.
    </p>
    <a class="button primary" href={localUrl("/")}>
      Return to OrbitKV <span aria-hidden="true">→</span>
    </a>
  </header>
</SiteLayout>
