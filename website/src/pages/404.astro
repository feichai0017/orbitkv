---
import SiteLayout from "../layouts/SiteLayout.astro";
import { localUrl } from "../data/site";
---

<SiteLayout title="Page not found — OrbitKV">
  <header class="page-hero container not-found">
    <p class="eyebrow">404</p>
    <h1>
      Outside
      <br />
      the orbit.
    </h1>
    <p>This page may have moved. Head back to the overview.</p>
    <a class="button primary" href={localUrl("/")}>
      Return to OrbitKV <span aria-hidden="true">→</span>
    </a>
  </header>
</SiteLayout>
