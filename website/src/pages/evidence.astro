---
import SiteLayout from "../layouts/SiteLayout.astro";
import { evidenceHighlights, records, sourceUrl } from "../data/site";
---

<SiteLayout
  title="Evidence — OrbitKV"
  description="Recorded OrbitKV correctness checks, artifact replay, and performance qualification."
  active="Evidence"
>
  <div class="container interior">
    <header class="page-hero">
      <p class="eyebrow">Evidence / 14 September 2026</p>
      <h1>
        Measure.
        <br />
        <span class="highlight">Then optimize.</span>
      </h1>
      <p>
        Results belong to a workload, hardware, and source revision. <br />
        These are the current checkpoints.
      </p>
    </header>
    <section class="detail-section" aria-labelledby="qualification-title">
      <h2 id="qualification-title">The latest H20 qualification</h2>
      <div class="metric-grid">
        {evidenceHighlights.map((item) => (
          <article>
            <strong>{item.value}</strong>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
      <p class="reading-copy">
        The recorded decode bucket selected FlashInfer tensor-core attention;
        packed prefill selected FlashAttention-3. Logit comparisons stayed
        within the existing error gate. HTTP cancellation and shutdown returned
        all KV pages and fixed-state pools to free state.
      </p>
      <p class="reading-copy">
        Serving performance remains an open optimization target. Current results
        establish no throughput advantage over vLLM or SGLang.
      </p>
      <a class="text-link" href={sourceUrl("docs/capability-matrix.md")}>
        Full capability and qualification limits{" "}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="detail-section" aria-labelledby="records-title">
      <div class="section-heading compact">
        <h2 id="records-title">Source records</h2>
        <a class="text-link" href={sourceUrl("results/README.md")}>
          All results <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="record-list">
        {records.map((record) => (
          <article>
            <time datetime={record.date}>{record.date}</time>
            <div>
              <h3>
                <a href={sourceUrl(record.path)}>
                  {record.name} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{record.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="reading-copy">
        Next: attribute 27B runtime and compile costs, optimize measured
        regions, then expand joint state and execution planning. See the{" "}
        <a href={sourceUrl("docs/roadmap.md")}>roadmap</a> and{" "}
        <a href={sourceUrl("docs/benchmarking.md")}>measurement method</a>.
      </p>
    </section>
  </div>
</SiteLayout>
