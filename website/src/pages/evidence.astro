---
import DocsNav from "../components/DocsNav.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { evidenceRows, metrics, repositoryUrl } from "../data/site";

const records = [
  {
    name: "Scoped Prefix correctness record",
    status: "Sealed, narrow engine scope",
    boundary: "Does not transfer to relocation, fixed state, performance, or production.",
    href: `${repositoryUrl}/tree/main/results/h20-sglang-v0517-abi8-full-hybrid-20260823`,
  },
  {
    name: "Scoped token-relocation record",
    status: "Sealed correctness and lifecycle scope",
    boundary: "Does not qualify sharing, broader state families, performance, or production.",
    href: `${repositoryUrl}/tree/main/results/h20-sglang-v0517-abi8-token-relocation-20260825`,
  },
  {
    name: "Fixed-state pair-verification record",
    status: "Scoped verification",
    boundary: "Not a general engine, performance, or production qualification.",
    href: `${repositoryUrl}/tree/main/results/h20-sglang-v0517-abi8-qwen35-fixed-state-pair-verification-20260823`,
  },
  {
    name: "Fixed-state diagnostic record",
    status: "Diagnostic only",
    boundary: "Unsealed evidence does not promote the integration boundary.",
    href: `${repositoryUrl}/tree/main/results/h20-sglang-v0517-abi8-qwen38-fp8-diagnostic-20260824`,
  },
];
---

<SiteLayout
  title="Evidence | OrbitKV"
  description="OrbitKV capability status and scoped evidence boundaries."
  active="Evidence"
>
  <header class="page-hero">
    <p class="eyebrow">Evidence</p>
    <h1>Each result keeps its boundary.</h1>
    <p>
      Host, component, engine, performance, and production evidence are
      separate claims. Qualification does not transfer between them.
    </p>
  </header>

  <div class="docs-layout">
    <DocsNav active="Evidence" />
    <article class="prose">
      <h2>Live ABI8 status</h2>
      <div class="metric-grid compact">
        {metrics.map((item) => (
          <article><strong>{item.value}</strong><div><h3>{item.label}</h3><p>{item.detail}</p></div></article>
        ))}
      </div>

      <h2>Capability summary</h2>
      <table class="evidence-table-native">
        <thead>
          <tr><th>Surface</th><th>Status</th><th>Contract</th><th>Boundary</th></tr>
        </thead>
        <tbody>
          {evidenceRows.map((item) => (
            <tr>
              <td>{item.result}</td>
              <td><code>{item.value}</code></td>
              <td>{item.contract}</td>
              <td>{item.boundary}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Scoped records</h2>
      <div class="doc-grid">
        {records.map((record) => (
          <div class="doc-card">
            <span>{record.status}</span>
            <h3>{record.name}</h3>
            <p>{record.boundary}</p>
            <a href={record.href}>Open record →</a>
          </div>
        ))}
      </div>

      <h2>Claim boundaries</h2>
      <ul>
        <li>ABI8 host gates do not by themselves establish engine or production qualification.</li>
        <li>Each sealed engine record applies only to its recorded feature boundary; scopes do not transfer.</li>
        <li>Packed COW has host coverage but remains outside the sealed engine scopes.</li>
        <li>Performance, capacity, memory saving, and production readiness remain pending.</li>
        <li>Historical and diagnostic records remain append-only and never qualify the live ABI8 tree automatically.</li>
      </ul>

      <p>
        The <a href={`${repositoryUrl}/blob/main/docs/capability-matrix.md`}>Capability Matrix</a>{" "}
        is the normative status surface. Full manifests, exact environments,
        methods, exclusions, and all historical records are in the{" "}
        <a href={`${repositoryUrl}/blob/main/results/README.md`}>Results Index</a>.
      </p>
    </article>
  </div>
</SiteLayout>
