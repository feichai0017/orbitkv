---
import DocsNav from "../components/DocsNav.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { evidenceRows, metrics, repositoryUrl } from "../data/site";

const resultsIndexUrl = `${repositoryUrl}/blob/main/results/README.md`;
---

<SiteLayout
  title="Evidence | OrbitKV"
  description="OrbitKV host status, open native-engine gates, and historical provenance."
  active="Evidence"
>
  <header class="page-hero">
    <p class="eyebrow">Evidence</p><h1>Every claim keeps its source boundary.</h1>
    <p>Implementation, host verification, device correctness, complete-engine behavior, measured benefit, and production readiness are separate levels.</p>
  </header>

  <div class="docs-layout">
    <DocsNav active="Evidence" />
    <article class="prose">
      <h2>Current architecture status</h2>
      <div class="metric-grid compact">{metrics.map((item) => (<article><strong>{item.value}</strong><div><h3>{item.label}</h3><p>{item.detail}</p></div></article>))}</div>

      <h2>Capability summary</h2>
      <table class="evidence-table-native">
        <thead><tr><th>Surface</th><th>Status</th><th>Contract</th><th>Boundary</th></tr></thead>
        <tbody>{evidenceRows.map((item) => (<tr><td>{item.result}</td><td><code>{item.value}</code></td><td>{item.contract}</td><td>{item.boundary}</td></tr>))}</tbody>
      </table>

      <h2>Open end-to-end gates</h2>
      <ul>
        <li>Run one released model through the complete RuntimeSession and Luminal transaction.</li>
        <li>Match output tokens or numerical state against an unchanged reference.</li>
        <li>Bind completion evidence to the real device stream before page reuse.</li>
        <li>Exercise Sliding and Chunked retirement boundaries and repeated generation reuse.</li>
        <li>Measure reserved and resident memory, capacity, latency, throughput, and copy overhead under the same workload.</li>
        <li>Pass cancellation, pressure, long-running reuse, and final-drain tests.</li>
      </ul>

      <h2>Historical records</h2>
      <p>
        Archived records remain unchanged because their exact model, hardware,
        source, protocol, and failed or successful gates are provenance. They do
        not qualify the current native architecture or imply a speedup. Open the
        <a href={resultsIndexUrl}>Results Index</a> for those scoped records.
      </p>
    </article>
  </div>
</SiteLayout>
