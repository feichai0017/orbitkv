---
import StateDiagram from "../components/StateDiagram.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { layers, localUrl, sourceUrl } from "../data/site";

const quickstart = [
  "# From a checkout of OrbitKV",
  "git submodule update --init --recursive",
  "cargo test --locked --all-targets",
].join("\n");
---

<SiteLayout active="Overview">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">State compiler / native inference</p>
      <h1 id="hero-title">
        Compile
        <br />
        the life
        <br />
        <span class="highlight">of state.</span>
      </h1>
      <p class="hero-description">
        OrbitKV plans what the model keeps. <br />
        Luminal compiles the work that uses it.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={localUrl("/docs/")}>
          Read the architecture <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#get-started">
          Get started <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <StateDiagram />
  </section>
  <section class="stack-section container" aria-labelledby="stack-title">
    <header class="section-heading">
      <div>
        <p class="eyebrow">01 / The system</p>
        <h2 id="stack-title">
          Three crates.
          <br />
          One process.
        </h2>
      </div>
      <a class="text-link" href={sourceUrl("docs/joint-compilation.md")}>
        Toward joint compilation <span aria-hidden="true">↗</span>
      </a>
    </header>
    <div class="layer-grid">
      {layers.map((layer) => (
        <article class="layer">
          <a class="package-name" href={sourceUrl(layer.path)}>
            {layer.name} <span aria-hidden="true">↗</span>
          </a>
          <h3>{layer.role}</h3>
          <p>{layer.detail}</p>
        </article>
      ))}
    </div>
    <p class="provider-line">
      <span>CUDA implementations</span> cuBLASLt · DeepGEMM · FlashInfer ·
      FlashAttention-3 · generated CUDA
    </p>
  </section>
  <section class="proof-band" aria-labelledby="evidence-title">
    <div class="container proof-inner">
      <div>
        <p class="eyebrow">02 / Current qualification</p>
        <h2 id="evidence-title">27B. Running.</h2>
        <p>Qwen3.8 block-FP8 · Full attention + Gated DeltaNet · NVIDIA H20</p>
      </div>
      <div class="proof-note">
        <p>
          Correctness qualified on bounded workloads. Serving performance is
          still being optimized.
        </p>
        <a class="text-link" href={localUrl("/evidence/")}>
          Inspect the evidence <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section
    class="get-started container"
    id="get-started"
    aria-labelledby="start-title"
  >
    <div>
      <p class="eyebrow">03 / Get started</p>
      <h2 id="start-title">
        Start at
        <br />
        the source.
      </h2>
      <p>Host tests run without a GPU.</p>
      <a class="text-link" href={sourceUrl("README.md#quickstart")}>
        Setup instructions <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="code-panel">
      <div class="code-bar">Terminal / host tests</div>
      <pre
        tabindex="0"
        aria-label="Commands to run host tests"
      ><code>{quickstart}</code></pre>
    </div>
  </section>
</SiteLayout>
