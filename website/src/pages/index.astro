---
import StateDiagram from "../components/StateDiagram.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { layers, localUrl, sourceUrl } from "../data/site";

const quickstart = [
  "# From a checkout of OrbitKV",
  "cargo check --workspace",
].join("\n");
---

<SiteLayout active="Overview">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">KV cache for vLLM and SGLang</p>
      <h1 id="hero-title">
        Reuse KV.<br />Across<br /><span class="highlight">cache tiers.</span>
      </h1>
      <p class="hero-description">
        GPU-validated single-node caching with one Cache Manager per host.<br />
        Distributed recovery and KV-aware routing are the next steps.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={localUrl("/docs/")}>
          Read the architecture <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#get-started">Get started <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <StateDiagram />
  </section>
  <section class="stack-section container" aria-labelledby="stack-title">
    <header class="section-heading">
      <div><p class="eyebrow">01 / The system</p><h2 id="stack-title">One cache API.<br />Several tiers.</h2></div>
      <a class="text-link" href={sourceUrl("docs/roadmap.md")}>Read the roadmap <span aria-hidden="true">↗</span></a>
    </header>
    <div class="layer-grid">
      {layers.map((layer) => (
        <article class="layer">
          <a class="package-name" href={sourceUrl(layer.path)}>{layer.name} <span aria-hidden="true">↗</span></a>
          <h3>{layer.role}</h3><p>{layer.detail}</p>
        </article>
      ))}
    </div>
    <p class="provider-line"><span>Now</span> Engine-owned HBM · pinned DRAM · optional SSD <span>Experimental</span> Mooncake remote fetch</p>
  </section>
  <section class="proof-band" aria-labelledby="evidence-title">
    <div class="container proof-inner">
      <div><p class="eyebrow">02 / Integration</p><h2 id="evidence-title">Two adapters.<br />One cache API.</h2><p>vLLM connector · SGLang GPU linker · node-local Cache Manager</p></div>
      <div class="proof-note"><p>Both adapters register GPU pages through CUDA IPC. A complete cross-framework recovery contract is still planned.</p><a class="text-link" href={localUrl("/integration/")}>Integration status <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="get-started container" id="get-started" aria-labelledby="start-title">
    <div><p class="eyebrow">03 / Get started</p><h2 id="start-title">Start at<br />the source.</h2><p>Host checks do not require a GPU.</p><a class="text-link" href={sourceUrl("README.md#build")}>Setup instructions <span aria-hidden="true">↗</span></a></div>
    <div class="code-panel"><div class="code-bar">Terminal / host checks</div><pre tabindex="0" aria-label="Commands to run host checks"><code>{quickstart}</code></pre></div>
  </section>
</SiteLayout>
