---
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  evidenceHighlights,
  executionStages,
  milestones,
  operatorFamilies,
  repositoryUrl,
} from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout active="Overview">
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-kicker">
        <span class="release-dot" aria-hidden="true"></span>
        <span>Alpha · NVIDIA SM90 · Rust 2024</span>
      </div>
      <h1>Inference operators,<br /><span>in Rust.</span></h1>
      <p class="hero-lede">
        Loom Infer is a FlashInfer-class operator layer for Rust LLM engines.
        It combines checked execution, cuda-oxide kernels, and qualified vendor
        libraries under one lifecycle.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}/docs/`}>Read the architecture</a>
        <a class="button quiet" href={`${base}/evidence/`}>Inspect the evidence</a>
      </div>
      <ul class="hero-facts" aria-label="Project boundaries">
        <li>Rust product API</li>
        <li>Rust device source</li>
        <li>No silent fallback</li>
      </ul>
    </div>

    <div class="execution-panel" aria-label="Loom Infer execution trace">
      <div class="panel-topline">
        <span>decode_step.trace</span>
        <span class="live-label"><i></i> checked</span>
      </div>
      <div class="trace-body">
        <div class="trace-row">
          <span class="trace-index">00</span>
          <div><small>contract</small><strong>BF16 · NHD · D128</strong></div>
          <span class="trace-state">valid</span>
        </div>
        <div class="trace-row">
          <span class="trace-index">01</span>
          <div><small>plan</small><strong>paged_decode::tp8</strong></div>
          <span class="trace-state">fixed</span>
        </div>
        <div class="trace-row">
          <span class="trace-index">02</span>
          <div><small>bindings</small><strong>6 read · 2 write</strong></div>
          <span class="trace-state">owned</span>
        </div>
        <div class="trace-row active">
          <span class="trace-index">03</span>
          <div><small>stream 7</small><strong>enqueue_into(scope)</strong></div>
          <span class="trace-state">submit</span>
        </div>
        <div class="trace-row">
          <span class="trace-index">04</span>
          <div><small>completion</small><strong>resources returned</strong></div>
          <span class="trace-state">fenced</span>
        </div>
      </div>
      <div class="panel-footline">
        <span>provider / cuda-oxide</span>
        <span>target / H20</span>
      </div>
    </div>
  </section>

  <section class="boundary-strip" aria-label="Product boundary">
    <span class="boundary-label">Loom owns</span>
    <strong>contracts · plans · bindings · kernels · completion</strong>
    <span class="boundary-separator" aria-hidden="true"></span>
    <span class="boundary-label">Engine owns</span>
    <strong>models · scheduling · requests · distributed policy</strong>
  </section>

  <section class="section" id="architecture">
    <header class="section-heading">
      <div>
        <p class="eyebrow">Execution model</p>
        <h2>One path from contract to completion.</h2>
      </div>
      <p>
        Custom kernels and vendor calls use the same typed bindings, stream,
        failure policy, and completion fence. Graph capture does not bypass the
        operator plan.
      </p>
    </header>

    <ol class="execution-rail">
      {executionStages.map((stage) => (
        <li>
          <span class="rail-key">{stage.key}</span>
          <div>
            <h3>{stage.name}</h3>
            <p>{stage.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="operators">
    <header class="section-heading">
      <div>
        <p class="eyebrow">Operator surface</p>
        <h2>Narrow contracts. Explicit status.</h2>
      </div>
      <p>
        Each provider fixes its dtype, layout, hardware, workspace, numerical
        limit, and Graph policy before admission.
      </p>
    </header>

    <div class="operator-board">
      <div class="operator-board-head" aria-hidden="true">
        <span>Operator</span><span>Current boundary</span><span>Provider</span><span>Status</span>
      </div>
      {operatorFamilies.map((family) => (
        <article class="operator-line">
          <h3>{family.name}</h3>
          <p>{family.boundary}</p>
          <code>{family.provider}</code>
          <span class:list={["status-tag", family.tone]}>{family.state}</span>
        </article>
      ))}
    </div>
    <a class="text-link" href={`${base}/docs/operators/`}>Open the operator matrix <span>→</span></a>
  </section>

  <section class="section evidence-section" id="evidence">
    <header class="section-heading">
      <div>
        <p class="eyebrow">Evidence ledger</p>
        <h2>Current, historical, and open stay separate.</h2>
      </div>
      <p>
        Attention rankings require a common oracle and exact contract key.
        Fused append still needs a provider-neutral oracle. Its current
        measurements are working-tree signals only.
      </p>
    </header>

    <div class="evidence-ledger">
      {evidenceHighlights.map((item, index) => (
        <article class="ledger-item">
          <span class="ledger-index">{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.value}</strong>
          <div>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
          </div>
          <small>{item.sample}</small>
        </article>
      ))}
    </div>
    <a class="text-link" href={`${base}/evidence/`}>Read methods and exclusions <span>→</span></a>
  </section>

  <section class="section boundary-section">
    <div class="boundary-statement">
      <p class="eyebrow">Scope</p>
      <h2>An operator layer.<br />No scheduler hidden inside.</h2>
    </div>
    <div class="boundary-cards">
      <article>
        <span>LOOM / IN SCOPE</span>
        <h3>Own the device boundary</h3>
        <p>Contracts, algorithm plans, memory authority, kernels, vendor calls, Graphs, and evidence.</p>
      </article>
      <article>
        <span>ENGINE / OUT OF SCOPE</span>
        <h3>Keep serving policy outside</h3>
        <p>Model graphs, batching, KV allocation policy, request lifecycle, networking, and distributed scheduling.</p>
      </article>
    </div>
  </section>

  <section class="section roadmap-section">
    <header class="section-heading">
      <div><p class="eyebrow">Next gates</p><h2>Correctness before surface area.</h2></div>
      <p>New operators wait until memory ownership, evidence, and engine invocation are closed.</p>
    </header>
    <div class="milestone-list">
      {milestones.map((item) => (
        <article>
          <span>{item.milestone}</span>
          <div><h3>{item.name}</h3><p>{item.reason}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="closing-band">
    <div>
      <p class="eyebrow">Source and evidence</p>
      <h2>Read the contracts. Check the records.</h2>
    </div>
    <div class="closing-actions">
      <a class="button primary" href={`${base}/docs/`}>Documentation</a>
      <a class="button quiet" href={repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </section>
</SiteLayout>
