---
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  compilerStages,
  evidenceRows,
  metrics,
  repositoryUrl,
  roadmap,
} from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout active="Overview">
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-kicker">
        <span class="release-dot" aria-hidden="true"></span>
        <span>ABI8 ownership runtime · scoped evidence · performance and production pending</span>
      </div>
      <h1>Attention semantics.<br /><span>Compiled into state.</span></h1>
      <p class="hero-lede">
        OrbitKV compiles attention and state-retention semantics into checked
        physical plans. It owns logical identities, generations, immutable
        snapshots, sharing, and reclamation while an inference engine keeps
        ownership of scheduling, kernels, tensor allocation, and execution.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}/docs/`}>Read the architecture</a>
        <a class="button quiet" href={`${base}/evidence/`}>Inspect evidence boundaries</a>
        <a class="button quiet" href={`${repositoryUrl}/blob/main/docs/capability-matrix.md`}>Capability matrix ↗</a>
      </div>
      <ul class="hero-facts" aria-label="Project boundaries">
        <li>Compiler-derived physical plans</li>
        <li>Token-level reclamation</li>
        <li>Packed copy-on-write</li>
      </ul>
    </div>

    <div class="kernel-console" aria-label="OrbitKV ownership program">
      <div class="console-bar">
        <span>orbitkv://ownership/plan</span>
        <span class="console-state"><i></i> checked</span>
      </div>
      <div class="console-grid" aria-hidden="true"></div>
      <div class="console-body">
        <div class="console-ident">
          <span>RETENTION</span>
          <strong>TOKEN + FIXED STATE · ABI8</strong>
        </div>
        <div class="provider-switch" aria-label="Physical lowering">
          <span class="selected">SEMANTICS</span>
          <span>PHYSICAL PLAN</span>
        </div>
        <div class="console-flow">
          <div><small>analyze</small><strong>retention relation</strong><em>01</em></div>
          <div><small>prepare</small><strong>copy + write intents</strong><em>02</em></div>
          <div><small>publish</small><strong>immutable snapshot</strong><em>03</em></div>
          <div class="flow-active"><small>reclaim</small><strong>death + done + ack</strong><em>04</em></div>
        </div>
      </div>
      <div class="console-footer">
        <span>identity / generation</span>
        <span>semantic / execution frontier</span>
      </div>
    </div>
  </section>

  <section class="scope-strip" aria-label="Project boundary">
    <div><span>ORBITKV OWNS</span><strong>plans · identities · snapshots · generations · reclamation</strong></div>
    <div><span>ENGINE OWNS</span><strong>allocation · scheduling · kernels · model execution</strong></div>
  </section>

  <section class="section" id="compiler">
    <header class="section-heading">
      <div><p class="eyebrow">Compilation pipeline</p><h2>Ownership emitted from semantics.</h2></div>
      <p>
        Physical layouts are lowering choices. The checked lifetime and
        ownership program remains the source of truth.
      </p>
    </header>
    <ol class="execution-chain">
      {compilerStages.map((stage) => (
        <li>
          <span class="chain-key">{stage.key}</span>
          <div><h3>{stage.name}</h3><p>{stage.detail}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section performance-section" id="evidence">
    <header class="section-heading">
      <div><p class="eyebrow">Qualification boundary</p><h2>Evidence stays inside its recorded scope.</h2></div>
      <p>
        ABI8 host gates cover the compiler, ownership lifecycle, packed COW,
        relocation, and adapter contracts. Separate sealed engine records cover
        narrow Prefix and token-relocation correctness scopes; one does not
        qualify the other. Packed COW remains host-qualified, and performance,
        capacity, broader execution modes, and production readiness remain
        pending. Historical records stay bound to their original ABI and do not
        qualify the live tree.
      </p>
    </header>
    <div class="metric-grid">
      {metrics.map((item) => (
        <article><strong>{item.value}</strong><div><h3>{item.label}</h3><p>{item.detail}</p></div></article>
      ))}
    </div>
    <div class="evidence-table" role="table" aria-label="OrbitKV evidence summary">
      <div class="evidence-row evidence-head" role="row">
        <span role="columnheader">Result</span>
        <span role="columnheader">Value</span>
        <span role="columnheader">Contract</span>
        <span role="columnheader">Boundary</span>
      </div>
      {evidenceRows.slice(0, 4).map((item) => (
        <div class="evidence-row" role="row">
          <strong role="cell">{item.result}</strong>
          <code role="cell">{item.value}</code>
          <span role="cell">{item.contract}</span>
          <small role="cell">{item.boundary}</small>
        </div>
      ))}
    </div>
    <a class="text-link" href={`${base}/evidence/`}>Inspect records and exclusions <span>→</span></a>
  </section>

  <section class="section roadmap-section" id="roadmap">
    <header class="section-heading">
      <div><p class="eyebrow">Next gates</p><h2>Expand the qualified ownership surface.</h2></div>
      <p>
        Each additional state family, packed operation, completion domain, and
        engine adapter must close its own correctness and qualification gates.
      </p>
    </header>
    <div class="milestone-list">
      {roadmap.map((item) => (
        <article><span>{item.state}</span><div><h3>{item.name}</h3><p>{item.detail}</p></div></article>
      ))}
    </div>
  </section>

  <section class="closing-band">
    <div><p class="eyebrow">Open source</p><h2>Compile lifetimes. Reuse with proof.</h2></div>
    <div class="closing-actions">
      <a class="button primary" href={`${base}/docs/`}>Architecture</a>
      <a class="button quiet" href={repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </section>
</SiteLayout>
