---
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  evidenceHighlights,
  operatorFamilies,
  repositoryUrl,
} from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout active="Overview">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Rust-native CUDA operators</p>
      <h1>Fast kernels.<br /><span>Checked execution.</span></h1>
      <p>
        A FlashInfer-class operator layer for Rust inference engines.
        Loom-owned kernels compile with cuda-oxide and run beside qualified
        vendor providers under one ownership model.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}/docs/`}>Get started</a>
        <a class="button" href={`${base}/evidence/`}>View evidence</a>
      </div>
      <p class="hero-note">Rust host · Rust device · CUDA SM90 · MIT</p>
    </div>

    <div class="kernel-window" aria-label="Target operator execution path">
      <div class="window-bar">
        <span>loom_infer::execute</span>
        <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <pre class="kernel-code"><code><span class="token-comment">// fixed before enqueue</span>
<span class="token-keyword">let</span> plan = provider.plan(spec)?;
<span class="token-keyword">let</span> bindings = queue.bindings(...)?;

<span class="token-keyword">let mut</span> scope = queue.begin(bindings)?;
plan.enqueue_into(&mut scope, args)?;
<span class="token-type">scope.finish().wait()?</span>;

<span class="token-comment">// no silent fallback</span></code></pre>
    </div>
  </section>

  <section class="metrics-strip" aria-label="Project status">
    <div class="metric"><strong>Rust</strong><span>host and device source</span></div>
    <div class="metric"><strong>SM90</strong><span>qualified first target</span></div>
    <div class="metric"><strong>H20</strong><span>recorded evidence</span></div>
    <div class="metric"><strong>v0.6.16</strong><span>pinned FlashInfer baseline</span></div>
  </section>

  <section class="section section-compact" id="operators">
    <header class="section-header">
      <div>
        <p class="eyebrow">Operators</p>
        <h2>A narrow, qualified surface.</h2>
      </div>
      <p>
        Each row fixes its shape, dtype, layout, numerical behavior, stream,
        workspace, and Graph policy before admission.
      </p>
    </header>
    <div class="operator-list">
      {operatorFamilies.map((family, index) => (
        <article class="operator-card">
          <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{family.name}</h3>
            <p>{family.boundary}</p>
          </div>
          <span class="status-pill">{family.state}</span>
        </article>
      ))}
    </div>
    <a class="section-link" href={`${base}/docs/operators/`}>Explore every contract →</a>
  </section>

  <section class="section section-compact">
    <header class="section-header">
      <div>
        <p class="eyebrow">Architecture</p>
        <h2>One lifecycle. Two provider classes.</h2>
      </div>
      <p>
        Rust kernels and vendor calls share checked bindings, caller-owned
        streams, one completion fence, and the same failure policy.
      </p>
    </header>
    <div class="principle-grid">
      <article class="principle-card">
        <span>01</span>
        <h3>Rust end to end</h3>
        <p>Contracts, plans, host execution, and custom kernels stay in Rust.</p>
      </article>
      <article class="principle-card">
        <span>02</span>
        <h3>Owned async safety</h3>
        <p>Writable allocations cannot escape while CUDA work is in flight.</p>
      </article>
      <article class="principle-card">
        <span>03</span>
        <h3>Evidence before defaults</h3>
        <p>Correctness, performance, Graph, engine, and serving gates stay separate.</p>
      </article>
    </div>
  </section>

  <section class="section section-compact" id="evidence">
    <header class="section-header">
      <div><p class="eyebrow">H20 evidence</p><h2>Numbers with boundaries.</h2></div>
      <p>
        Representative matched results against the pinned FlashInfer release.
        Every record keeps raw samples, provider order, and excluded claims.
      </p>
    </header>
    <div class="highlight-grid">
      {evidenceHighlights.map((item) => (
        <article class="highlight-card">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
    <a class="section-link" href={`${base}/evidence/`}>Read methods, raw records, and exclusions →</a>
  </section>

  <section class="cta-band">
    <div>
      <p class="eyebrow">Alpha</p>
      <h2>Build the Rust operator layer.</h2>
      <p>Next: broader attention contracts, Graph coverage, and real engine integration.</p>
    </div>
    <div class="cta-actions">
      <a class="button primary" href={`${base}/docs/`}>Documentation</a>
      <a class="button" href={repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </section>
</SiteLayout>
