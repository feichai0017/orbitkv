---
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  engineAdapters,
  evidenceHighlights,
  executionStages,
  milestones,
  operatorGroups,
  performanceEvidenceUrl,
  pagedPrefillCurrentEvidenceUrl,
  raggedPrefillOptimizationEvidenceUrl,
  performanceRows,
  performanceSummary,
  providerLanes,
  repositoryUrl,
} from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout active="Overview">
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-kicker">
        <span class="release-dot" aria-hidden="true"></span>
        <span>Rust 2024 · NVIDIA CUDA · alpha</span>
      </div>
      <h1>One runtime.<br /><span>Two provider paths.</span></h1>
      <p class="hero-lede">
        Oxide Infer is a Rust-native GPU operator runtime for LLM inference.
        Native CUDA kernels and vendor libraries use the same planning, memory,
        stream, and completion contract.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}/docs/`}>Read the contracts</a>
        <a class="button quiet" href={`${base}/docs/operators/`}>View operators</a>
      </div>
      <ul class="hero-facts" aria-label="Project boundaries">
        <li>Explicit provider selection</li>
        <li>No silent fallback</li>
        <li>Evidence per contract</li>
      </ul>
    </div>

    <div class="kernel-console" aria-label="Oxide Infer execution plan">
      <div class="console-bar">
        <span>oxide://plan/decode</span>
        <span class="console-state"><i></i> admitted</span>
      </div>
      <div class="console-grid" aria-hidden="true"></div>
      <div class="console-body">
        <div class="console-ident">
          <span>SPEC</span>
          <strong>BF16 · NHD · D128</strong>
        </div>
        <div class="provider-switch" aria-label="Provider selection">
          <span class="selected">NATIVE</span>
          <span>VENDOR</span>
        </div>
        <div class="console-flow">
          <div><small>planner</small><strong>paged_decode</strong><em>01</em></div>
          <div><small>algorithm</small><strong>eight_warp</strong><em>02</em></div>
          <div><small>workspace</small><strong>caller_owned</strong><em>03</em></div>
          <div class="flow-active"><small>command</small><strong>enqueue_into(scope)</strong><em>04</em></div>
        </div>
      </div>
      <div class="console-footer">
        <span>stream / external</span>
        <span>completion / fenced</span>
      </div>
    </div>
  </section>

  <section class="scope-strip" aria-label="Product boundary">
    <div><span>OXIDE OWNS</span><strong>operator contracts · planning · GPU submission · completion</strong></div>
    <div><span>ENGINE OWNS</span><strong>model graph · batching · request and distributed policy</strong></div>
  </section>

  <section class="section" id="execution">
    <header class="section-heading">
      <div><p class="eyebrow">Unified execution chain</p><h2>One path to the device.</h2></div>
      <p>
        Planning fixes the provider and algorithm before enqueue. Native kernels
        and vendor calls share typed operands, workspace rules, stream admission,
        and resource retention.
      </p>
    </header>
    <ol class="execution-chain">
      {executionStages.map((stage) => (
        <li>
          <span class="chain-key">{stage.key}</span>
          <div><h3>{stage.name}</h3><p>{stage.detail}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="operators">
    <header class="section-heading">
      <div><p class="eyebrow">Operator matrix</p><h2>Source, experiment, and roadmap stay separate.</h2></div>
      <p>
        A row describes only its listed contract. Current source does not imply
        current performance evidence, and a planned row is not an API promise.
      </p>
    </header>
    <div class="operator-matrix">
      {operatorGroups.map((group) => (
        <section class:list={["operator-group", group.tone]}>
          <header><span>{group.state}</span><p>{group.note}</p></header>
          <div class="operator-list">
            {group.operators.map((operator) => (
              <article>
                <h3>{operator.name}</h3>
                <p>{operator.boundary}</p>
                <code>{operator.provider}</code>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
    <a class="text-link" href={`${base}/docs/operators/`}>Open the full boundary table <span>→</span></a>
  </section>

  <section class="section provider-section" id="providers">
    <header class="section-heading">
      <div><p class="eyebrow">Provider architecture</p><h2>Native and vendor.<br />One contract.</h2></div>
      <p>
        The planner selects a provider. Enqueue does not tune, switch providers,
        or fall back. Unsupported combinations return a planning error.
      </p>
    </header>
    <div class="provider-diagram">
      <div class="provider-core">
        <span>SHARED RUNTIME</span>
        <strong>Spec → Planner → Plan</strong>
        <small>typed operands · command scope · completion</small>
      </div>
      <div class="provider-branches" aria-hidden="true"><i></i><i></i></div>
      <div class="provider-lanes">
        {providerLanes.map((lane) => (
          <article>
            <span>{lane.id}</span>
            <h3>{lane.name}</h3>
            <p>{lane.detail}</p>
            <ul>{lane.examples.map((example) => <li>{example}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section performance-section" id="performance">
    <header class="section-heading">
      <div><p class="eyebrow">Measured performance</p><h2>Fast paths—and the gaps.</h2></div>
      <p>
        Current-source BF16 eager-provider timing against FlashInfer 0.6.17.
        These are operator measurements on one recorded H20, not model or
        serving results.
      </p>
    </header>
    <div class="performance-summary">
      {performanceSummary.map((item) => (
        <article><strong>{item.value}</strong><div><h3>{item.label}</h3><p>{item.detail}</p></div></article>
      ))}
    </div>
    <div class="performance-table" role="table" aria-label="Representative H20 latency comparison with FlashInfer">
      <div class="performance-row performance-head" role="row">
        <span role="columnheader">Contract</span>
        <span role="columnheader">Oxide</span>
        <span role="columnheader">FlashInfer</span>
        <span role="columnheader">Result</span>
      </div>
      {performanceRows.map((item) => (
        <div class:list={["performance-row", item.winner]} role="row">
          <div role="cell"><strong>{item.name}</strong><small>{item.shape}</small></div>
          <code role="cell">{item.oxideUs} µs</code>
          <code role="cell">{item.flashinferUs} µs</code>
          <span role="cell">{item.result}</span>
        </div>
      ))}
    </div>
    <p class="performance-note">
      NVIDIA H20 · CUDA events · 200 warmups · 100 samples/provider/shape across
      both orders. The long paged- and ragged-GQA4 rows are refreshed from
      optimized source; the other rows retain the 14-shape baseline.
    </p>
    <a class="text-link" href={performanceEvidenceUrl} target="_blank" rel="noreferrer">
      Open all 14 shapes and raw samples <span>↗</span>
    </a>
    <a class="text-link" href={pagedPrefillCurrentEvidenceUrl} target="_blank" rel="noreferrer">
      Open the current paged-GQA4 record <span>↗</span>
    </a>
    <a class="text-link" href={raggedPrefillOptimizationEvidenceUrl} target="_blank" rel="noreferrer">
      Open the optimized ragged-GQA4 record <span>↗</span>
    </a>
  </section>

  <section class="section" id="evidence">
    <header class="section-heading">
      <div><p class="eyebrow">Evidence boundary</p><h2>What the records prove—and what they do not.</h2></div>
      <p>
        Evidence is scoped by source revision, GPU, operator contract, toolchain,
        and method. Correctness does not establish performance or serving impact.
      </p>
    </header>
    <div class="evidence-ledger">
      {evidenceHighlights.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.value}</strong>
          <div><h3>{item.label}</h3><p>{item.detail}</p></div>
          <small>{item.sample}</small>
        </article>
      ))}
    </div>
    <a class="text-link" href={`${base}/evidence/`}>Inspect methods and exclusions <span>→</span></a>
  </section>

  <section class="section roadmap-section" id="roadmap">
    <header class="section-heading">
      <div><p class="eyebrow">Engine roadmap</p><h2>Complete one model before adding breadth.</h2></div>
      <p>The accepted target uses a Mistral.rs shell, an Oxide data plane, and offline TileLang artifacts.</p>
    </header>
    <div class="milestone-list">
      {milestones.map((item) => (
        <article><span>{item.milestone}</span><div><h3>{item.name}</h3><p>{item.reason}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section adapter-section" id="adapters">
    <header class="section-heading">
      <div><p class="eyebrow">Engine adapter entry</p><h2>The runtime stops at a narrow seam.</h2></div>
      <p>
        An adapter supplies engine-owned streams and allocations, maps model
        tensors to typed operands, and reports provider hits. Scheduling stays
        in the engine.
      </p>
    </header>
    <div class="adapter-flow">
      <div class="adapter-ingress"><span>ENGINE</span><strong>model call</strong><small>stream + tensor regions</small></div>
      <div class="adapter-gate"><span>ADAPTER</span><strong>contract mapping</strong><small>no-copy proof + provider trace</small></div>
      <div class="adapter-runtime"><span>OXIDE</span><strong>planned operator</strong><small>completion returns authority</small></div>
    </div>
    <div class="adapter-grid">
      {engineAdapters.map((adapter) => (
        <article><span>{adapter.state}</span><h3>{adapter.name}</h3><p>{adapter.detail}</p></article>
      ))}
    </div>
  </section>

  <section class="closing-band">
    <div><p class="eyebrow">Read the source</p><h2>Contracts first. Claims second.</h2></div>
    <div class="closing-actions">
      <a class="button primary" href={`${base}/docs/`}>Documentation</a>
      <a class="button quiet" href={repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </section>
</SiteLayout>
