---
import { getCollection, render } from "astro:content";
import { docPages } from "../../data/docs";
import DocLayout from "../../layouts/DocLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("docs");
  const ids = new Set(pages.map((entry) => entry.id));
  for (const page of docPages) {
    if (!ids.has(page.slug))
      throw new Error(`Missing documentation source: ${page.slug}`);
  }
  return pages.map((entry) => {
    const page = docPages.find((page) => page.slug === entry.id);
    if (!page)
      throw new Error(`Add ${entry.id} to the documentation navigation`);
    return { params: { slug: entry.id }, props: { entry, page } };
  });
}

const { entry, page } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout title={page.title} slug={page.slug} headings={headings}>
  <Content />
</DocLayout>
