---
import DocsNav from "../../components/DocsNav.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { repositoryUrl } from "../../data/site";
---

<SiteLayout
  title="Documentation | Loom Infer"
  description="Architecture, roadmap, operator contracts, and evidence for Loom Infer."
>
  <header class="page-hero">
    <p class="eyebrow">Documentation</p>
    <h1>Start from the boundary.</h1>
    <p>Loom Infer is an operator library. The engine keeps model and serving policy.</p>
  </header>

  <div class="docs-layout">
    <DocsNav active="Start" />
    <article class="prose">
      <h2>Start here</h2>
      <div class="doc-grid">
        <div class="doc-card">
          <h3>Architecture</h3>
          <p>Read the Rust source boundary and one operator lifecycle.</p>
          <a href={`${repositoryUrl}/blob/main/docs/design/loom-infer-architecture.md`}>Architecture</a>
        </div>
        <div class="doc-card">
          <h3>Roadmap</h3>
          <p>Follow the RMSNorm, vendor GEMM, attention, and decode phases.</p>
          <a href={`${repositoryUrl}/blob/main/docs/roadmap.md`}>Roadmap</a>
        </div>
        <div class="doc-card">
          <h3>Operators</h3>
          <p>Check the current slice and target operator surface.</p>
          <a href={`${repositoryUrl}/blob/main/docs/operator-catalog.md`}>Operator catalog</a>
        </div>
        <div class="doc-card">
          <h3>H20 validation</h3>
          <p>Run each correctness, stream, graph, sanitizer, and performance gate separately.</p>
          <a href={`${repositoryUrl}/blob/main/docs/development/h20-validation.md`}>Validation guide</a>
        </div>
      </div>

      <h2>Validate the current workspace</h2>
      <pre><code>git clone https://github.com/feichai0017/loom-infer.git
cd loom-infer
cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace --all-targets</code></pre>
      <p>
        The <a href={`${repositoryUrl}/blob/main/docs/results/README.md`}>evidence index</a>
        contains the RMSNorm, BF16 GEMM, CUDA Graph, single-decode, and paged
        batch-decode results.
      </p>
    </article>
  </div>
</SiteLayout>
