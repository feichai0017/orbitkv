---
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  compilerStages,
  docs,
  layers,
  providers,
  sourceUrl,
} from "../../data/site";
---

<SiteLayout
  title="Architecture — OrbitKV"
  description="State ownership, measured CUDA compilation, and native Rust serving."
  active="Architecture"
>
  <div class="container interior">
    <header class="page-hero">
      <p class="eyebrow">Architecture</p>
      <h1>
        State.
        <br />
        <span class="highlight">Compile.</span>
        <br />
        Serve.
      </h1>
      <p>
        OrbitKV owns state. Luminal compiles execution. <br />
        Explicit contracts connect them.
      </p>
    </header>
    <section class="detail-section" aria-labelledby="crates-title">
      <h2 id="crates-title">The three-crate boundary</h2>
      <div class="definition-list">
        {layers.map((layer) => (
          <div>
            <a class="package-name" href={sourceUrl(layer.path)}>
              {layer.name} <span aria-hidden="true">↗</span>
            </a>
            <p>{layer.detail}</p>
          </div>
        ))}
      </div>
    </section>
    <section class="detail-section" aria-labelledby="compile-title">
      <h2 id="compile-title">From semantics to a saved program</h2>
      <ol class="compile-flow">
        {compilerStages.map((stage) => (
          <li>
            <h3>{stage.name}</h3>
            <p>{stage.detail}</p>
          </li>
        ))}
      </ol>
      <p class="reading-copy">
        Candidates follow math, dtype, shape, state layout, and device
        capability. Generated CUDA and external libraries share the search
        space. Current attention executes over causal or sliding paged NHD K/V.
      </p>
      <dl class="provider-list">
        {providers.map((provider) => (
          <div>
            <dt>{provider.name}</dt>
            <dd>{provider.role}</dd>
          </div>
        ))}
      </dl>
      <p class="reading-copy">
        Search measures the alternatives supplied by compiler rules. Joint
        KV-layout search and general megakernel generation remain future work.
      </p>
      <a class="text-link" href={sourceUrl("docs/attention-providers.md")}>
        Provider contracts and setup <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="detail-section" aria-labelledby="docs-title">
      <h2 id="docs-title">Read the contracts</h2>
      <div class="doc-links">
        {docs.map((doc) => (
          <a href={sourceUrl(doc.path)}>
            {doc.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
