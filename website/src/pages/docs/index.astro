---
import DocLayout from "../../layouts/DocLayout.astro";
import { docGroups } from "../../data/docs";
import { localUrl, sourceUrl } from "../../data/site";
---

<DocLayout title="Documentation">
  <p class="eyebrow">OrbitKV / Documentation</p>
  <h1>
    A cache beyond
    <br />
    <span class="highlight">GPU memory.</span>
  </h1>
  <p>
    Connect vLLM or SGLang to one Cache Manager per host. Reuse KV from pinned
    DRAM and SSD, inspect transfer behavior, and explore the experimental
    shared-cache path.
  </p>
  <div class="doc-cards">
    <a class="doc-card" href={localUrl("/docs/single-node/#vllm")}>
      <h2>Start with vLLM →</h2>
      <p>
        Install the connector, start the manager, and verify an external cache
        hit.
      </p>
    </a>
    <a class="doc-card" href={localUrl("/docs/single-node/#sglang")}>
      <h2>Start with SGLang →</h2>
      <p>
        Enable the GPU-page linker and reuse cached prefixes through the same
        manager.
      </p>
    </a>
  </div>
  <div class="doc-callout">
    <strong>Current scope</strong>
    <p>
      The validated baselines are vLLM 0.29.0 and SGLang 0.5.20. Single-rank
      DRAM/SSD recovery has GPU gates. Distributed serving, P/D plus cache
      reuse, and catalog replication have separate qualification gates.{" "}
      <a href={localUrl("/docs/deployment/")}>Check deployment support.</a>
    </p>
  </div>
  {docGroups.map((group) => (
    <section>
      <h2>{group.title}</h2>
      <p>{group.description}</p>
      <ul>
        {group.items.map((item) => (
          <li>
            <a href={localUrl(`/docs/${item.slug}/`)}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <h2>Build and contribute</h2>
  <p>
    Technical pages are published directly from the repository's documentation.
    Start with the <a href={sourceUrl("AGENTS.md")}>contributor guide</a>,{" "}
    <a href={sourceUrl("python/tests/README.md")}>test gates</a>, and{" "}
    <a href={sourceUrl("benches/README.md")}>benchmark harness</a>.
  </p>
</DocLayout>
