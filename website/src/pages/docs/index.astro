---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compilerStages, docs, layers, providers, sourceUrl } from "../../data/site";
---

<SiteLayout title="Architecture — OrbitKV" description="Semantic KV lifetime planning over a production storage and transfer data plane." active="Architecture">
  <div class="container interior">
    <header class="page-hero">
      <p class="eyebrow">Architecture</p>
      <h1>State.<br /><span class="highlight">Place.</span><br />Reuse.</h1>
      <p>SGLang schedules execution. OrbitKV owns durable cache identity.<br />Lifetime and placement converge behind an explicit boundary.</p>
    </header>
    <section class="detail-section" aria-labelledby="crates-title">
      <h2 id="crates-title">One cache, four boundaries</h2>
      <div class="definition-list">
        {layers.map((layer) => (<div><a class="package-name" href={sourceUrl(layer.path)}>{layer.name} <span aria-hidden="true">↗</span></a><p>{layer.detail}</p></div>))}
      </div>
    </section>
    <section class="detail-section" aria-labelledby="compile-title">
      <h2 id="compile-title">From semantics to a physical cache plan</h2>
      <ol class="compile-flow">{compilerStages.map((stage) => (<li><h3>{stage.name}</h3><p>{stage.detail}</p></li>))}</ol>
      <p class="reading-copy">Full, sliding, sink-local, and recurrent state expose different future read sets. OrbitKV derives retention and placement from those semantics plus measured transfer and recompute costs.</p>
      <dl class="provider-list">{providers.map((provider) => (<div><dt>{provider.name}</dt><dd>{provider.role}</dd></div>))}</dl>
      <p class="reading-copy">Ring buffers, tier movement, compression, and replica placement are physical outcomes. They are not independent hand-tuned features.</p>
      <a class="text-link" href={sourceUrl("docs/architecture.md")}>Architecture and safety contract <span aria-hidden="true">↗</span></a>
    </section>
    <section class="detail-section" aria-labelledby="docs-title">
      <h2 id="docs-title">Read the contracts</h2>
      <div class="doc-links">{docs.map((doc) => (<a href={sourceUrl(doc.path)}>{doc.name}<span aria-hidden="true">↗</span></a>))}</div>
    </section>
  </div>
</SiteLayout>
