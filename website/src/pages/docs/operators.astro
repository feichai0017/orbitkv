---
import DocsNav from "../../components/DocsNav.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { milestones, operatorFamilies, repositoryUrl } from "../../data/site";
---

<SiteLayout
  title="Operators | Loom Infer"
  description="The current and planned operator surface for Loom Infer."
  active="Operators"
>
  <header class="page-hero">
    <p class="eyebrow">Operators</p>
    <h1>One lifecycle for every operator.</h1>
    <p>The current H20 records cover narrow BF16 single and paged decode contracts.</p>
  </header>

  <div class="docs-layout">
    <DocsNav active="Operators" />
    <article class="prose">
      <h2>Operator families</h2>
      <table class="operator-table">
        <thead>
          <tr><th>Family</th><th>Boundary</th><th>State</th></tr>
        </thead>
        <tbody>
          {operatorFamilies.map((operator) => (
            <tr>
              <td>{operator.name}</td>
              <td>{operator.boundary}</td>
              <td>{operator.state}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Admission</h2>
      <ol>
        <li>A named engine profile shows memory, launch, layout, or scheduling cost.</li>
        <li>Loom can enter the path without copying tensors into private storage.</li>
        <li>A model or serving workload can prove the final value.</li>
      </ol>
      <p>
        A Rust provider passes contract, device, named-baseline, graph, engine,
        and serving gates independently. Read the full
        <a href={`${repositoryUrl}/blob/main/docs/operator-catalog.md`}>operator catalog</a>.
      </p>

      <h2>Next work</h2>
      <div class="doc-grid">
        {milestones.map((item) => (
          <div class="doc-card">
            <span class="card-index">{item.milestone}</span>
            <h3>{item.name}</h3>
            <p>{item.reason}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</SiteLayout>
