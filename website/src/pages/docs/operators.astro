---
import DocsNav from "../../components/DocsNav.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { nextOperators, repositoryUrl, supportedOperators } from "../../data/site";
---

<SiteLayout
  title="Operators | Loom Kernels"
  description="The implemented and profile-gated operator paths in Loom Kernels."
  active="Operators"
>
  <header class="page-hero">
    <p class="eyebrow">Operators</p>
    <h1>A narrow, measured surface</h1>
    <p>
      Loom admits memory-bound work that a real engine can reach without copies.
      GEMM stays with the engine or vendor library.
    </p>
  </header>

  <div class="docs-layout">
    <DocsNav active="Operators" />
    <article class="prose">
      <h2>Current paths</h2>
      <table class="operator-table">
        <thead>
          <tr><th>Operator</th><th>Dtypes</th><th>Boundary</th><th>Status</th></tr>
        </thead>
        <tbody>
          {supportedOperators.map((operator) => (
            <tr>
              <td>{operator.name}</td>
              <td>{operator.dtypes}</td>
              <td>{operator.boundary}</td>
              <td>{operator.status}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Admission</h2>
      <ol>
        <li>A named engine profile shows memory, launch, layout, or scheduling cost.</li>
        <li>Loom can enter the path without copying tensors into private storage.</li>
        <li>A model or serving workload can prove the final value.</li>
      </ol>
      <p>
        Every admitted path still passes contract, oracle, CUDA, named-baseline,
        framework, engine, and system gates. Read the full
        <a href={`${repositoryUrl}/blob/main/docs/operator-catalog.md`}>operator catalog</a>.
      </p>

      <h2>Next work</h2>
      <div class="doc-grid">
        {nextOperators.map((item) => (
          <div class="doc-card">
            <span class="card-index">{item.milestone}</span>
            <h3>{item.name}</h3>
            <p>{item.reason}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
</SiteLayout>
