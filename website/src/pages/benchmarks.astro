---
import DocsNav from "../components/DocsNav.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { evidence, repositoryUrl } from "../data/site";

const resultUrl = (file: string) => `${repositoryUrl}/blob/main/docs/results/${file}`;
---

<SiteLayout
  title="Evidence | Loom Kernels"
  description="Qualified H20 results and claim boundaries for Loom Kernels."
  active="Evidence"
>
  <header class="page-hero">
    <p class="eyebrow">NVIDIA H20 evidence</p>
    <h1>Measurements with explicit limits</h1>
    <p>
      Each result names its shape, dtype, baseline, warm-up, sample count, and
      correctness gate. Operator speed does not imply model speed.
    </p>
  </header>

  <div class="docs-layout">
    <DocsNav active="Evidence" />
    <article class="prose">
      <h2>Representative results</h2>
      <div class="evidence-grid">
        {evidence.map((item) => (
          <a class="evidence-card" href={resultUrl(item.file)}>
            <h3>{item.operator}</h3>
            <span class="result">{item.result}</span>
            <p>{item.detail}</p>
            <small>{item.shape}</small>
          </a>
        ))}
      </div>

      <h2>Read a ratio</h2>
      <p>
        A ratio is baseline latency divided by Loom latency. A value above 1.0
        favors Loom for that exact boundary. It says nothing about another
        shape, model, framework version, or end-to-end workload.
      </p>

      <h2>Validation order</h2>
      <ol>
        <li>Validate the contract and CPU oracle.</li>
        <li>Compare CUDA output across edge and representative shapes.</li>
        <li>Measure against a named warmed baseline.</li>
        <li>Check current-stream dispatch, compilation, and CUDA Graph replay.</li>
        <li>Prove invocation from a real engine.</li>
        <li>Measure model or serving value separately.</li>
      </ol>

      <p>
        The <a href={`${repositoryUrl}/blob/main/docs/results/README.md`}>evidence index</a>
        links every raw JSON result and its reproduction command. It keeps
        accepted, parity, fallback, and rejected experiments.
      </p>
    </article>
  </div>
</SiteLayout>
