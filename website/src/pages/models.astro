---
import SiteLayout from "../layouts/SiteLayout.astro";
import { models, performance, plannedModels } from "../data/models";
import { sourceUrl } from "../data/site";
const number = (value: number) => value.toFixed(1);
const inputRange = (values: number[]) =>
  values.length === 1
    ? String(values[0])
    : `${Math.min(...values)}–${Math.max(...values)}`;
---

<SiteLayout
  title="Models & performance — OrbitKV"
  description="Model support and measured inference performance on NVIDIA H20."
  active="Models"
>
  <div class="container interior">
    <header class="page-hero">
      <p class="eyebrow">Models & performance</p>
      <h1>
        Models that run.
        <br />
        <span class="highlight">Numbers you can check.</span>
      </h1>
      <p>
        Text inference on one NVIDIA H20.
        <br />
        Support and speed, with the workload attached.
      </p>
    </header>

    <section class="detail-section" aria-labelledby="models-title">
      <div class="section-heading compact">
        <h2 id="models-title">Model support</h2>
        <a class="text-link" href={sourceUrl("docs/capability-matrix.md")}>
          Full capabilities <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="model-grid">
        {models.map((model) => (
          <article class="model-card">
            <p class="model-status">{model.status}</p>
            <h3>
              <a href={sourceUrl(model.path)}>
                {model.name} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p class="model-spec">
              {model.precision} · {model.attention}
            </p>
            <p>{model.scope}</p>
          </article>
        ))}
      </div>
      <p class="reading-copy">
        Planned: {plannedModels.join(" · ")}. These targets are not yet
        supported. See the{" "}
        <a href={sourceUrl("docs/model-targets.md")}>single-H20 roadmap</a>.
      </p>
    </section>

    <section class="detail-section" aria-labelledby="performance-title">
      <div class="section-heading compact">
        <h2 id="performance-title">Measured inference</h2>
        <a class="text-link" href={sourceUrl("results/README.md")}>
          All model results <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="reading-copy">
        HTTP streaming after server readiness. Concurrency is the number of
        in-flight requests. TTFT measures time to the first token; TPOT measures
        average time per subsequent token.
      </p>
      {performance.length === 0 && (
        <p class="reading-copy">
          The current-build benchmark is being qualified. Historical
          measurements remain available in the model results.
        </p>
      )}
      {performance.map((report) => (
        <article class="performance-report">
          <div class="report-heading">
            <h3>
              {report.model.name} <span>{report.model.precision}</span>
            </h3>
            <p>
              {report.hardware.count} × {report.hardware.name} ·{" "}
              <time datetime={report.measured_at}>{report.measured_at}</time>
            </p>
          </div>
          <div
            class="table-scroll"
            role="region"
            aria-label={`${report.model.name} inference measurements`}
            tabindex="0"
          >
            <table class="performance-table">
              <caption>
                Latency: median / P95 in ms. Throughput: output tokens/s across
                all requests, with the range across runs below.
              </caption>
              <thead>
                <tr>
                  <th scope="col">Input / output</th>
                  <th scope="col">Concurrency</th>
                  <th scope="col">Tokens/s</th>
                  <th scope="col">TTFT</th>
                  <th scope="col">TPOT</th>
                  <th scope="col">GPU GiB*</th>
                </tr>
              </thead>
              <tbody>
                {report.workloads.map((row) => (
                  <tr>
                    <th scope="row">
                      {inputRange(row.input_tokens)} / {row.output_tokens}
                    </th>
                    <td>
                      {row.concurrency}
                      {!row.output_repeatable && (
                        <sup aria-label="Generated outputs varied across runs">
                          †
                        </sup>
                      )}
                    </td>
                    <td class="performance-value">
                      {number(row.metrics.output_throughput)}
                      <small class="metric-range">
                        {number(row.metric_ranges.output_throughput.minimum)}–
                        {number(row.metric_ranges.output_throughput.maximum)}
                      </small>
                    </td>
                    <td>
                      {number(row.metrics.median_ttft_ms)} /{" "}
                      {number(row.metrics.p95_ttft_ms)}
                    </td>
                    <td>
                      {number(row.metrics.median_tpot_ms)} /{" "}
                      {number(row.metrics.p95_tpot_ms)}
                    </td>
                    <td>
                      {row.sampled_max_device_gpu_bytes === null
                        ? "—"
                        : number(row.sampled_max_device_gpu_bytes / 2 ** 30)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="table-note">
            {report.measurement} *GPU memory is the largest sampled device usage
            during serving, not an allocation peak.
          </p>
          {report.notes.map((note) => (
            <p class="table-note">{note}</p>
          ))}
          {report.workloads.some((row) => !row.output_repeatable) && (
            <p class="table-note">
              † Generated text varied across repeated runs. These are workload
              timing observations, not matched-output comparisons.
            </p>
          )}
          <a class="text-link" href={sourceUrl(report.path)}>
            Configuration, individual runs and reproduction{" "}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
      <p class="reading-copy">
        Performance depends on context, concurrency and precision. These
        measurements establish no throughput advantage over vLLM or SGLang.{" "}
        <a href={sourceUrl("docs/benchmarking.md")}>Measurement method ↗</a>
      </p>
    </section>
  </div>
</SiteLayout>
